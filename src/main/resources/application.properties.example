# ============================================================
# 社区投票系统 - 配置文件模板
# 使用方法：复制此文件为 application.properties，填入自己的配置
# 注意：application.properties 已被 .gitignore 忽略，不会被提交到仓库
# ============================================================

# ---------- 数据库配置 ----------
# 将 password 改为你自己的 MySQL 密码
spring.datasource.url=jdbc:mysql://localhost:3306/vote_db?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=你的MySQL密码

# ---------- JPA 配置 ----------
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# ---------- 服务器端口 ----------
server.port=8080

# ---------- AI 大模型配置 ----------
# 在 https://open.bigmodel.cn/ 注册并获取 API Key
ai.api-key=你的智谱AI_API_Key
ai.model=glm-4-flash
ai.base-url=https://open.bigmodel.cn/api/paas/v4